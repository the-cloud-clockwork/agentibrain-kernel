# Unified compose for the agentibrain kernel, rendered by `agentibrain up`.
#
# Service URLs resolve over the shared ``agentibrain_net`` bridge network.
#
# This renders the whole brain: storage (postgres, redis), the API and
# index (brain-api, embeddings), the maintenance loop (tick-cron, tick-drain,
# amygdala) and the Claude Code adapter (mcp). The repo's own compose.yml
# additionally mounts the host's Claude transcripts and agentihooks outbox for
# extraction and marker drain; both are host integrations, so a packaged
# deployment leaves them out and tick-cron skips those passes.

{% if compose_project %}name: {{ compose_project }}
{% endif %}services:
  postgres:
    image: pgvector/pgvector:pg16
{% if not compose_project %}    container_name: agentibrain_postgres
{% endif %}    restart: unless-stopped
    environment:
      POSTGRES_USER: agentibrain
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-agentibrain}
      POSTGRES_DB: agentibrain
    volumes:
      - agentibrain_pg_data:/var/lib/postgresql/data
    ports:
      - "127.0.0.1:{{ postgres_port | default(5432) }}:5432"
    networks: [agentibrain_net]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U agentibrain"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
{% if not compose_project %}    container_name: agentibrain_redis
{% endif %}    restart: unless-stopped
    volumes:
      - agentibrain_redis_data:/data
    ports:
      - "127.0.0.1:{{ redis_port | default(6379) }}:6379"
    networks: [agentibrain_net]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

{% if ollama %}
  ollama:
    image: ollama/ollama:latest
{% if not compose_project %}    container_name: agentibrain_ollama
{% endif %}    restart: unless-stopped
    volumes:
      - agentibrain_ollama_data:/root/.ollama
    ports:
      - "127.0.0.1:{{ ollama_port | default(11434) }}:11434"
    networks: [agentibrain_net]
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

  ollama-init:
    image: ollama/ollama:latest
{% if not compose_project %}    container_name: agentibrain_ollama_init
{% endif %}    depends_on:
      ollama: { condition: service_healthy }
    environment:
      OLLAMA_HOST: http://ollama:11434
    entrypoint: ["/bin/sh", "-c"]
    # Both pulls are required: the chat model answers ticks and kb_brief, the
    # embed model backs semantic search. Without the second, /health/deep
    # reports embeddings unconfigured on a stack that looks complete.
    command:
      - |
        ollama pull {{ ollama_chat_model }}
        ollama pull {{ ollama_embed_model }}
    networks: [agentibrain_net]
{% endif %}
  embeddings:
    image: {{ embeddings_image | default("ghcr.io/the-cloud-clockwork/agentibrain-embeddings:dev") }}
{% if not compose_project %}    container_name: agentibrain_embeddings
{% endif %}    restart: unless-stopped
    depends_on:
      postgres: { condition: service_healthy }
    environment:
{% for name, default in service_env_defaults.items() %}      {{ name }}: ${ {{- name -}}:-{{ default }}}
{% endfor %}
      POSTGRES_URL: postgresql://agentibrain:${POSTGRES_PASSWORD:-agentibrain}@postgres:5432/agentibrain
{% if ollama %}      LLM_API_BASE: http://ollama:11434/v1
      LLM_API_KEY: ollama
      LLM_EMBED_MODEL: {{ ollama_embed_model }}
{% else %}      LLM_API_BASE: ${LLM_API_BASE:-}
      LLM_API_KEY: ${LLM_API_KEY:-}
      LLM_EMBED_MODEL: ${LLM_EMBED_MODEL:-text-embedding-3-small}
{% endif %}
      # Pin the vector dimension when LLM_EMBED_MODEL is not a recognised
      # family; required for unknown models (the service refuses to guess).
      EMBED_DIM: {% if ollama %}768{% else %}${EMBED_DIM:-}{% endif %}
      EMBED_DIM_FORCE_MIGRATE: {% if ollama %}true{% else %}${EMBED_DIM_FORCE_MIGRATE:-}{% endif %}
      API_KEYS: ${EMBEDDINGS_API_KEYS:-}
      AUTH_MODE: ${AUTH_MODE:-}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
    networks: [agentibrain_net]
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8080/health')"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s

  brain-api:
    image: {{ brain_api_image | default("ghcr.io/the-cloud-clockwork/agentibrain-brain-api:dev") }}
{% if not compose_project %}    container_name: agentibrain_brain_api
{% endif %}    restart: unless-stopped
    labels:
      agentibrain.vault: "{{ vault_path }}"
    depends_on:
      postgres: { condition: service_healthy }
      embeddings: { condition: service_started }
    environment:
{% for name, default in service_env_defaults.items() %}      {{ name }}: ${ {{- name -}}:-{{ default }}}
{% endfor %}
      ARTIFACT_STORE_URL: ${ARTIFACT_STORE_URL:-}
      VAULT_ROOT: /vault
      RAW_INBOX_PREFIX: raw/inbox
      EMBEDDINGS_URL: http://embeddings:8080
      EMBEDDINGS_API_KEY: ${EMBEDDINGS_API_KEY:-}
{% if ollama %}      INFERENCE_URL: http://ollama:11434/v1
      INFERENCE_API_KEY: ollama
      BRAIN_CLASSIFY_MODEL: {{ ollama_chat_model }}
{% else %}      INFERENCE_URL: ${INFERENCE_URL:-}
      INFERENCE_API_KEY: ${INFERENCE_API_KEY:-}
      BRAIN_CLASSIFY_MODEL: ${BRAIN_CLASSIFY_MODEL:-brain-classify}
{% endif %}
      LOCAL_READ_ROOTS: ${LOCAL_READ_ROOTS:-/workspace,/mnt/ingest}
      KB_ROUTER_TOKEN: ${KB_ROUTER_TOKEN}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
      # /health/pipeline thresholds. Defaults track the cadences here:
      # tick-drain polls every TICK_DRAIN_INTERVAL_SECONDS (30s), tick-cron
      # fires every TICK_INTERVAL_SECONDS (2h).
      PIPELINE_PENDING_STUCK_SECONDS: ${PIPELINE_PENDING_STUCK_SECONDS:-300}
      PIPELINE_TICK_STALE_HOURS: ${PIPELINE_TICK_STALE_HOURS:-6}
      PIPELINE_FEED_STALE_HOURS: ${PIPELINE_FEED_STALE_HOURS:-6}
      PIPELINE_MARKER_QUIET_HOURS: ${PIPELINE_MARKER_QUIET_HOURS:-72}
      SIGNAL_DEDUP_SCAN_MAX: ${SIGNAL_DEDUP_SCAN_MAX:-300}
      # Shared with brain-ops: the pipeline check reads the same lesson-feed
      # cap and window the tick writes with, so a mismatch reads as a defect.
      BRAIN_LESSON_FEED_MAX: ${BRAIN_LESSON_FEED_MAX:-6}
      BRAIN_STALE_LESSON_DAYS: ${BRAIN_STALE_LESSON_DAYS:-14}
    volumes:
      - "{{ vault_path }}:/vault:rw"
    ports:
      - "{{ bind_host | default('0.0.0.0') }}:{{ brain_api_port | default(8103) }}:8080"
    networks: [agentibrain_net]
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://127.0.0.1:8080/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

  tick-cron:
    image: {{ brain_ops_image | default("ghcr.io/the-cloud-clockwork/agentibrain-brain-ops:dev") }}
{% if not compose_project %}    container_name: agentibrain_tick_cron
{% endif %}    restart: unless-stopped
    depends_on:
      redis: { condition: service_healthy }
      brain-api: { condition: service_healthy }
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
{% raw %}        set -e
        INTERVAL="$${TICK_INTERVAL_SECONDS:-7200}"
        echo "[tick-cron] starting; interval=$${INTERVAL}s"
        while true; do
          python3 /app/tick_cycle.py scheduled --vault /vault \
            || echo "[tick-cron] tick cycle failed; the failed phase is logged above"
          echo "[tick-cron] sleeping $${INTERVAL}s until next tick"
          sleep "$${INTERVAL}"
        done
{% endraw %}    environment:
{% for name, default in service_env_defaults.items() %}      {{ name }}: ${ {{- name -}}:-{{ default }}}
{% endfor %}
      TICK_CYCLE_MODE: vault
      REDIS_URL: ${REDIS_URL:-redis://redis:6379/11}
{% if ollama %}      INFERENCE_URL: http://ollama:11434/v1
      INFERENCE_API_KEY: ollama
      BRAIN_BRIEF_MODEL: {{ ollama_chat_model }}
      EMBEDDING_STATE_GENERATION: ollama-{{ ollama_embed_model }}-768
{% else %}      INFERENCE_URL: ${INFERENCE_URL:-}
      INFERENCE_API_KEY: ${INFERENCE_API_KEY:-}
      BRAIN_BRIEF_MODEL: ${BRAIN_BRIEF_MODEL:-brain-brief}
{% endif %}
      EMBEDDINGS_URL: http://embeddings:8080
      EMBEDDINGS_API_KEY: ${EMBEDDINGS_API_KEY:-}
      TICK_INTERVAL_SECONDS: ${TICK_INTERVAL_SECONDS:-7200}
      BRAIN_LLM_TIMEOUT_SECONDS: ${BRAIN_LLM_TIMEOUT_SECONDS:-600}
      BRAIN_PROMPT_MAX_CHARS: ${BRAIN_PROMPT_MAX_CHARS:-12000}
      BRAIN_LLM_MAX_TOKENS: ${BRAIN_LLM_MAX_TOKENS:-512}
      BRAIN_PROMOTE_HEAT: ${BRAIN_PROMOTE_HEAT:-5}
      BRAIN_DEMOTE_HEAT: ${BRAIN_DEMOTE_HEAT:-3}
      BRAIN_GRADUATE_HEAT: ${BRAIN_GRADUATE_HEAT:-1}
      BRAIN_GRADUATE_AGE_DAYS: ${BRAIN_GRADUATE_AGE_DAYS:-14}
      BRAIN_MAX_SYNTH_ARCS: ${BRAIN_MAX_SYNTH_ARCS:-25}
      BRAIN_API_URL: http://brain-api:8080
      KB_ROUTER_TOKEN: ${KB_ROUTER_TOKEN:-}
      CLICKHOUSE_URL: ${CLICKHOUSE_URL:-}
      CLICKHOUSE_USER: ${CLICKHOUSE_USER:-default}
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD:-}
      CLICKHOUSE_DATABASE: ${CLICKHOUSE_DATABASE:-brain}
      CLICKHOUSE_TICK_TABLE: ${CLICKHOUSE_TICK_TABLE:-tick_health}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
    volumes:
      - "{{ vault_path }}:/vault:rw"
    networks: [agentibrain_net]

  tick-drain:
    image: {{ brain_ops_image | default("ghcr.io/the-cloud-clockwork/agentibrain-brain-ops:dev") }}
{% if not compose_project %}    container_name: agentibrain_tick_drain
{% endif %}    restart: unless-stopped
    depends_on:
      brain-api: { condition: service_healthy }
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
{% raw %}        set -eu
        INTERVAL="$${TICK_DRAIN_INTERVAL_SECONDS:-30}"
        echo "[tick-drain] starting; interval=$${INTERVAL}s"
        while true; do
          python3 /app/tick_cycle.py drain --vault /vault \
            || echo "[tick-drain] tick cycle failed; unfinished requests stay queued for retry"
          sleep "$$INTERVAL"
        done
{% endraw %}    environment:
{% for name, default in service_env_defaults.items() %}      {{ name }}: ${ {{- name -}}:-{{ default }}}
{% endfor %}
{% if ollama %}      INFERENCE_URL: http://ollama:11434/v1
      INFERENCE_API_KEY: ollama
      BRAIN_BRIEF_MODEL: {{ ollama_chat_model }}
      EMBEDDING_STATE_GENERATION: ollama-{{ ollama_embed_model }}-768
{% else %}      INFERENCE_URL: ${INFERENCE_URL:-}
      INFERENCE_API_KEY: ${INFERENCE_API_KEY:-}
      BRAIN_BRIEF_MODEL: ${BRAIN_BRIEF_MODEL:-brain-brief}
{% endif %}
      EMBEDDINGS_URL: http://embeddings:8080
      # Empty fails every tick: an unindexed tick is not a completed one.
      EMBEDDINGS_API_KEY: ${EMBEDDINGS_API_KEY:-}
      TICK_DRAIN_INTERVAL_SECONDS: ${TICK_DRAIN_INTERVAL_SECONDS:-30}
      BRAIN_LLM_TIMEOUT_SECONDS: ${BRAIN_LLM_TIMEOUT_SECONDS:-600}
      BRAIN_PROMPT_MAX_CHARS: ${BRAIN_PROMPT_MAX_CHARS:-12000}
      BRAIN_LLM_MAX_TOKENS: ${BRAIN_LLM_MAX_TOKENS:-512}
      # Must mirror tick-cron: a drain-triggered tick and a scheduled tick have
      # to promote/demote arcs identically, or heat oscillates between them.
      BRAIN_PROMOTE_HEAT: ${BRAIN_PROMOTE_HEAT:-5}
      BRAIN_DEMOTE_HEAT: ${BRAIN_DEMOTE_HEAT:-3}
      BRAIN_GRADUATE_HEAT: ${BRAIN_GRADUATE_HEAT:-1}
      BRAIN_GRADUATE_AGE_DAYS: ${BRAIN_GRADUATE_AGE_DAYS:-14}
      BRAIN_MAX_SYNTH_ARCS: ${BRAIN_MAX_SYNTH_ARCS:-25}
      CLICKHOUSE_URL: ${CLICKHOUSE_URL:-}
      CLICKHOUSE_USER: ${CLICKHOUSE_USER:-default}
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD:-}
      CLICKHOUSE_DATABASE: ${CLICKHOUSE_DATABASE:-brain}
      CLICKHOUSE_TICK_TABLE: ${CLICKHOUSE_TICK_TABLE:-tick_health}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
    volumes:
      - "{{ vault_path }}:/vault:rw"
    networks: [agentibrain_net]

  amygdala:
    image: {{ brain_ops_image | default("ghcr.io/the-cloud-clockwork/agentibrain-brain-ops:dev") }}
{% if not compose_project %}    container_name: agentibrain_amygdala
{% endif %}    restart: unless-stopped
    depends_on:
      redis: { condition: service_healthy }
    # The DB override lives in amygdala.py (--db / AMYGDALA_DB), not in a shell
    # rewrite here: `${URL%/*}/11` turns a legal `redis://host:6379` into
    # `redis://11` and connects to a host named "11".
    command:
      - /app/amygdala.py
      - --continuous
      - --poll-interval
      - "5"
      - --vault
      - /vault
      - --brain-feed
      - /vault/brain-feed
    environment:
{% for name, default in service_env_defaults.items() %}      {{ name }}: ${ {{- name -}}:-{{ default }}}
{% endfor %}
      REDIS_URL: ${REDIS_URL:-redis://redis:6379/11}
      AMYGDALA_DB: ${AMYGDALA_DB:-11}
      AMYGDALA_STREAMS: ${AMYGDALA_STREAMS:-events:health,events:host,events:deploy,events:system,events:brain}
      AMYGDALA_CONSUMER: ${AMYGDALA_CONSUMER:-amygdala-local}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
    volumes:
      - "{{ vault_path }}:/vault:rw"
    networks: [agentibrain_net]

  mcp:
    image: {{ mcp_image | default("ghcr.io/the-cloud-clockwork/agentibrain-mcp:dev") }}
{% if not compose_project %}    container_name: agentibrain_mcp
{% endif %}    restart: unless-stopped
    depends_on:
      brain-api: { condition: service_healthy }
    environment:
{% for name, default in service_env_defaults.items() %}      {{ name }}: ${ {{- name -}}:-{{ default }}}
{% endfor %}
{% if ollama %}      INFERENCE_URL: http://ollama:11434/v1
      INFERENCE_API_KEY: ollama
      BRAIN_BRIEF_MODEL: {{ ollama_chat_model }}
{% else %}      INFERENCE_URL: ${INFERENCE_URL:-}
      INFERENCE_API_KEY: ${INFERENCE_API_KEY:-}
      BRAIN_BRIEF_MODEL: ${BRAIN_BRIEF_MODEL:-brain-brief}
{% endif %}
      BRAIN_API_URL: http://brain-api:8080
      KB_ROUTER_TOKEN: ${KB_ROUTER_TOKEN:-}
      EMBEDDINGS_URL: http://embeddings:8080
      EMBEDDINGS_API_KEY: ${EMBEDDINGS_API_KEY:-}
      MCP_AUTH_MODE: local
      MCP_PROXY_API_KEY: ""
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
    ports:
      - "127.0.0.1:{{ mcp_port | default(8104) }}:8080"
    networks: [agentibrain_net]

volumes:
{% if ollama %}  agentibrain_ollama_data:
{% endif %}  agentibrain_pg_data:
  agentibrain_redis_data:

networks:
  agentibrain_net:
    driver: bridge
